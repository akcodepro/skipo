<div class="workout-complete" id="workout_session">
  <div class="workout-complete__backdrop"></div>

  <div class="workout-complete__card">
    <p class="workout-complete__label">Workout complete</p>

    <p>
      <span class="workout-complete__number"><%= (workout_session.actual_duration_seconds / 60.0).round %></span>
      <span class="workout-complete__unit">min</span>
    </p>

    <h1 class="workout-complete__title"><%= workout_session.workout.title %></h1>

    <p class="workout-complete__message">[Random message here]</p>

    <div class="workout-complete__actions">
      <%= link_to "Done", workout_sessions_path, class: "button button--primary" %>
    </div>
  </div>
</div>
