<% stopped = workout_session.stopped? %>

<%= tag.div(
  class: class_names("workout-complete", "workout-complete--stopped": stopped),
  id: "workout_session",
  data: (stopped ? {} : { controller: "celebrate share-flow" })
) do %>
  <div class="workout-complete__backdrop"></div>

  <% unless stopped %>
    <canvas
      class="workout-complete__confetti"
      data-celebrate-target="canvas">
    </canvas>
  <% end %>

  <div class="workout-complete__card"
      data-share-flow-target="summary">

    <p class="workout-complete__label">
      <%= stopped ? "Workout stopped" : "Workout complete" %>
    </p>

    <p class="workout-complete__result">
      <%# keep on one line: whitespace shows at this size %>
      <span class="workout-complete__number"><%= (workout_session.actual_duration_seconds / 60.0).round %></span>
      <%# keep on one line: whitespace shows at this size %>
      <span class="workout-complete__unit"><%= stopped ? "of #{workout_session.workout.requested_duration_seconds / 60} min" : "min" %></span>
    </p>

    <h1 class="workout-complete__title">
      <%= workout_session.workout.title %>
    </h1>

    <p class="workout-complete__message">
      <%= finish_message(workout_session) %>
    </p>

    <div class="workout-complete__actions">
      <% unless stopped %>
        <button type="button"
                class="button button--primary button--block"
                data-action="click->share-flow#open">
          Share workout
        </button>

        <%= link_to "Done",
          workout_sessions_path,
          class: "button button--text" %>
      <% else %>
        <%= link_to "Done",
          workout_sessions_path,
          class: "button button--primary button--block" %>
      <% end %>
    </div>

    <% if stopped %>
      <p class="workout-complete__note">
        Only finished workouts can be shared.
      </p>
    <% end %>
  </div>

  <% unless stopped %>
    <%= render "workout_sessions/share_card",
      workout_session: workout_session %>
  <% end %>
<% end %>
