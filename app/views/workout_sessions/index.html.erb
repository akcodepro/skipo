<%#= render "shared/coming_soon",
  icon: "fa-solid fa-chart-line",
  title: "Your progress lives here soon",
  text: "Every workout you finish will land here. Streaks, minutes, personal bests." %>


<div class="progress-page">
  <div class="progress-page__header">
    <h1 class="progress-page__title">Progress</h1>

    <nav class="range-switch" aria-label="Time range">
      <% WorkoutSessionsController::RANGES.each do |value, label| %>
        <%= link_to label,
            workout_sessions_path(range: value),
            class: class_names(
              "range-switch__option",
              "range-switch__option--active" => @range == value
            ),
            aria: { current: ("page" if @range == value) } %>
      <% end %>
    </nav>
  </div>

  <section class="activity" aria-label="Activity" style="--periods: <%= @bars.length %>">
    <div class="activity__summary">
      <div class="activity__week">
        <span class="activity__label">This week</span>
        <span class="activity__week-value">
          <%= human_duration(@week_seconds) %>
          <span class="activity__week-detail">
            · <%= pluralize(@week_count, "workout") %>
          </span>
        </span>
      </div>

      <div class="activity__total">
        <span class="activity__total-value">
          <%= human_duration(@range_seconds) %>
        </span>
        <span class="activity__label">
          <%= { "3m" => "in 3 months", "1y" => "in 1 year", "all" => "in total" }[@range] %>
        </span>
      </div>
    </div>

    <% max_seconds = @bars.map(&:last).max.to_f %>

    <div class="activity__bars" aria-hidden="true">
      <% @bars.each_with_index do |(_date, seconds), index| %>
        <% height = max_seconds.zero? ? 0 : (seconds / max_seconds * 100).round %>
        <span
          class="<%= class_names(
            "activity__bar",
            "activity__bar--current" => index == @bars.length - 1,
            "activity__bar--empty" => seconds.zero?
          ) %>"
          style="--value: <%= height %>%"
        ></span>
      <% end %>
    </div>

    <% if @calendar_days %>
      <% current_week_start = Date.current.beginning_of_week %>

      <div
        class="activity__calendar"
        aria-hidden="true"
      >
        <% @calendar_days.each do |date, seconds| %>
          <% future = date > Date.current %>
          <% current = date >= current_week_start %>
          <% size = seconds.zero? ? 4 : [6 + (seconds / 300.0), 10].min %>

          <span
            class="<%= class_names(
              "activity__day",
              "activity__day--current" => current,
              "activity__day--empty" => seconds.zero?,
              "activity__day--future" => future
            ) %>"
            style="--size: <%= size %>px"
          ></span>
        <% end %>
      </div>
    <% end %>

    <div class="activity__axis" aria-hidden="true">
      <% @bars.each_index do |index| %>
        <span class="activity__tick"><%= axis_label(@bars, index) %></span>
      <% end %>
    </div>

  </section>

  <h2 class="progress-page__heading">How you train</h2>

  <div class="training">
    <div class="training__tiles">
      <div class="training__tile">
        <span class="training__tile-label">Go-to duration</span>
        <span class="training__tile-value">
          <%= human_duration(@usual_duration_seconds) %>
        </span>
      </div>

      <div class="training__tile">
        <span class="training__tile-label">Go-to level</span>
        <span class="training__tile-value">
          <%= Workout::DIFFICULTY_LEVELS[@usual_difficulty] %>
        </span>
      </div>
    </div>

    <p class="training__mix-label">What you pick on top of Fundamentals</p>

    <div class="training__mix" aria-hidden="true">
      <% @focus_mix.each do |focus, percentage| %>
        <div
          class="training__mix-segment training__mix-segment--<%= focus %>"
          style="--value: <%= percentage %>">
        </div>
      <% end %>
    </div>

    <div class="training__legend">
      <% @focus_mix.each do |focus, percentage| %>
        <span class="training__legend-item"><%= focus_label(focus) %> <%= percentage %>%</span>
      <% end %>
    </div>
  </div>

  <h2 class="progress-page__heading">History</h2>

  <ul class="history">
    <% @workout_sessions.each do |workout_session| %>
      <% workout = workout_session.workout %>
      <li class="history__item">
        <div class="history__top">
          <div class="history__heading">
            <span class="history__date"><%= session_date(workout_session.started_at) %></span>
            <span class="history__title"><%= workout.title %></span>
          </div>
          <span class="history__duration"><%= human_duration(workout_session.actual_duration_seconds) %></span>
        </div>

        <% if workout_session.stopped? %>
          <p class="history__stopped">
            <svg class="history__stopped-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9"></path></svg>
            Stopped at <%= (workout_session.actual_duration_seconds / 60.0).round %> of <%= workout.requested_duration_seconds / 60 %> min
          </p>
        <% end %>

        <p class="history__moves"><%= first_moves(workout) %></p>

        <div class="history__pills">
          <% if workout.fundamentals_only? %>
            <span class="pill pill--fundamentals">
              <%= focus_icon("fundamentals", extra_class: "pill__icon") %>
              <%= focus_label("fundamentals") %>
            </span>
          <% else %>
            <% (workout.focus - [ "fundamentals" ]).each do |focus| %>
              <span class="pill pill--outline">
                <%= focus_icon(focus, extra_class: "pill__icon") %>
                <%= focus_label(focus) %>
              </span>
            <% end %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</div>
