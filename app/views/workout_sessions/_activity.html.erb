<section class="activity" aria-label="Activity" style="--periods: <%= @bars.length %>">
  <div class="activity__summary">
    <div class="activity__week">
      <span class="activity__label">This week</span>
      <span class="activity__week-value">
        <%= human_duration(@week_seconds) %>
        <span class="activity__week-detail">· <%= pluralize(@week_count, "workout") %></span>
      </span>
    </div>

    <div class="activity__total">
      <span class="activity__total-value"><%= human_duration(@range_seconds) %></span>
      <span class="activity__label">
        <%= { "3m" => "in 3 months", "1y" => "in 1 year", "all" => "in total" }[@range] %>
      </span>
    </div>
  </div>

  <% if @calendar_days %>
    <div class="activity__swipe"
      data-controller="swipe-dots"
      data-swipe-dots-active-class="activity__dot--active">
      <div class="activity__panels" data-swipe-dots-target="panels" data-action="scroll->swipe-dots#update">
        <div class="activity__panel"><%= render "workout_sessions/bars" %></div>
        <div class="activity__panel"><%= render "workout_sessions/calendar" %></div>
      </div>

      <%= render "workout_sessions/axis" %>

      <div class="activity__dots">
        <% [ "Show bars", "Show calendar" ].each_with_index do |label, index| %>
          <button type="button"
            class="<%= class_names("activity__dot", "activity__dot--active" => index.zero?) %>"
            aria-label="<%= label %>"
            data-swipe-dots-target="dot"
            data-index="<%= index %>"
            data-action="click->swipe-dots#go"></button>
        <% end %>
      </div>
    </div>
  <% else %>
    <%= render "workout_sessions/bars" %>
    <%= render "workout_sessions/axis" %>
  <% end %>
</section>
