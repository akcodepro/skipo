<span class="avatar avatar--<%= avatar_color(user) %>">
  <% if user.profile_photo.attached? %>
    <%= image_tag user.profile_photo,
      class: "avatar__image",
      alt: "",
      loading: "lazy" %>
  <% else %>
    <span aria-hidden="true"><%= user.display_name.first %></span>
  <% end %>
</span>
