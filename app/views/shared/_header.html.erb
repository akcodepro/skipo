<header class="app-header">
  <%= link_to root_path, class: "app-header__logo" do %>
    <span>SKIPO</span>
    <%#= image_tag "logo.png", alt: "SKIPO" %>
  <% end %>

  <% if user_signed_in? %>
    <%= link_to "Log out",
        destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "app-header__action" %>
  <% else %>
    <%= link_to "Log in",
        new_user_session_path,
        class: "app-header__action" %>
  <% end %>
</header>
