<%# locals: (inverse: false, signed_in: user_signed_in?) -%>
<header class="<%= class_names("app-header", "app-header--inverse" => inverse) %>">
  <%= link_to root_path, class: "app-header__logo" do %>
    <span>SKIPO</span>
  <% end %>

  <% if signed_in %>
    <%= link_to "Log out",
        destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "app-header__action" %>
  <% else %>
    <%= link_to "Log in",
        new_user_session_path,
        class: "app-header__action" %>
  <% end %>
</header>
