        <span class="liquid-navbar__label">Train</span>
      <% end %>

      <% feed_active = controller_name == "shared_workouts" %>
      <%= link_to shared_workouts_path,
          class: class_names(
            "liquid-navbar__link",
            "liquid-navbar__link--active" => feed_active
          ),
          aria: { current: ("page" if feed_active) } do %>
        <i class="liquid-navbar__icon fa-solid fa-users" aria-hidden="true"></i>
        <span class="liquid-navbar__label">Feed</span>
      <% end %>

    </div>
  </nav>
<% end %>
