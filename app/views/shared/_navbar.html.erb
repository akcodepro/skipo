<% if user_signed_in? %>
  <nav class="liquid-navbar" aria-label="Primary navigation">
    <div class="liquid-navbar__bar">

      <%= link_to workout_sessions_path,
          class: "liquid-navbar__link #{'is-active' if current_page?(workout_sessions_path)}",
          aria: { current: ("page" if current_page?(workout_sessions_path)) } do %>
        <span>Progress</span>
      <% end %>

      <%= link_to new_workout_path,
          class: "liquid-navbar__link #{'is-active' if current_page?(new_workout_path)}",
          aria: { current: ("page" if current_page?(new_workout_path)) } do %>
        <span>Train</span>
      <% end %>

      <%= link_to shared_workouts_path,
          class: "liquid-navbar__link #{'is-active' if current_page?(shared_workouts_path)}",
          aria: { current: ("page" if current_page?(shared_workouts_path)) } do %>
        <span>Feed</span>
      <% end %>

    </div>
  </nav>
<% end %>
