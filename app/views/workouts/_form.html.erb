<%= simple_form_for workout do |f| %>

  <div
    class="workout-builder__section"
    data-controller="stepper"
    data-stepper-options-value="<%= WorkoutGenerator::DURATION_TOLERANCES.keys.to_json %>"
  >
    <h2 class="workout-builder__section-title">
      How long?
    </h2>

    <%= f.input :requested_duration_seconds,
          as: :hidden,
          input_html: {
            value: 900,
            data: { stepper_target: "input" }
          } %>
    <div class="stepper">
      <button
        type="button"
        class="stepper__control"
        data-stepper-target="decrementButton"
        data-action="stepper#decrement"
        aria-label="Decrease workout duration"
      >
        &minus;
      </button>

      <div class="stepper__display" aria-live="polite">
        <span class="stepper__value" data-stepper-target="value">15</span>
        <span class="stepper__unit">min</span>
      </div>

      <button
        type="button"
        class="stepper__control"
        data-stepper-target="incrementButton"
        data-action="stepper#increment"
        aria-label="Increase workout duration"
      >
        &plus;
      </button>
    </div>
  </div>

  <%= f.input :focus,
        label: "What would you like to focus on?",
        as: :check_boxes,
        collection: Exercise.categories.keys.map { |category| [category.titleize, category] },
        label_method: :first,
        value_method: :last,
        wrapper_html: { class: "workout-form__field workout-form__focus" },
        item_wrapper_class: "workout-form__choice" %>

  <%= f.input :difficulty,
        label: "How difficult should it be?",
        wrapper_html: { class: "workout-form__field workout-form__difficulty" } do %>

    <div class="difficulty-slider">
      <%= f.range_field :difficulty,
            min: Workout::DIFFICULTY_LEVELS.keys.min,
            max: Workout::DIFFICULTY_LEVELS.keys.max,
            step: 1,
            class: "slider" %>

      <div class="difficulty-levels">
        <% Workout::DIFFICULTY_LEVELS.each_value do |label| %>
          <span><%= label %></span>
        <% end %>
      </div>
    </div>

  <% end %>

  <%= f.button :submit, "Generate workout",
        class: "workout-form__submit" %>

<% end %>
