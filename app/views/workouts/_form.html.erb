<%= simple_form_for workout, html: { class: "workout-builder__form" } do |f| %>

  <section
    class="workout-builder__section"
    data-controller="stepper"
    data-stepper-options-value="<%= Workout::DURATIONS.to_json %>"
  >
    <h2 class="workout-builder__section-title">
      How long?
    </h2>

    <%= f.hidden_field :requested_duration_seconds,
          value: 900,
          data: { stepper_target: "input" } %>
    <div class="stepper">
      <button
        type="button"
        class="stepper__control"
        data-stepper-target="decrementButton"
        data-action="stepper#decrement"
        aria-label="Decrease workout duration"
      >
        &minus;
      </button>

      <div class="stepper__display" aria-live="polite">
        <span class="stepper__value" data-stepper-target="value">15</span>
        <span class="stepper__unit">min</span>
      </div>

      <button
        type="button"
        class="stepper__control"
        data-stepper-target="incrementButton"
        data-action="stepper#increment"
        aria-label="Increase workout duration"
      >
        &plus;
      </button>
    </div>
  </section>

  <section class="workout-builder__section">
    <h2 class="workout-builder__section-title">
      What do you want to work on?
    </h2>

    <div class="choice-grid">
      <div class="choice-tile choice-tile--locked choice-tile--wide">
        <%= focus_icon("fundamentals", extra_class: "choice-tile__icon") %>
        <span class="choice-tile__label">Fundamentals</span>
        <span class="choice-tile__lock">
          <i class="fa-solid fa-lock" aria-hidden="true"></i>
          <span class="visually-hidden">Always included</span>
        </span>
      </div>

      <%= f.collection_check_boxes(
        :focus,
        Exercise.categories.keys.reject { |category| category == "fundamentals" },
        :itself,
        ->(category) { focus_label(category) },
        { item_wrapper_tag: false }
      ) do |b| %>
        <div class="choice-grid__item">
          <%= b.check_box(class: "choice-tile__input") %>

          <%= b.label(class: "choice-tile") do %>
            <%= focus_icon(b.value, extra_class: "choice-tile__icon") %>
            <span class="choice-tile__label"><%= b.text %></span>
          <% end %>
        </div>
      <% end %>
    </div>
    <p class="workout-builder__note">
      Fundamentals are always in, they are the base every other move builds on.
    </p>
  </section>

  <%= f.input :difficulty,
        label: "How difficult should it be?",
        wrapper_html: { class: "workout-form__field workout-form__difficulty" } do %>

    <div class="difficulty-slider">
      <%= f.range_field :difficulty,
            min: Workout::DIFFICULTY_LEVELS.keys.min,
            max: Workout::DIFFICULTY_LEVELS.keys.max,
            step: 1,
            class: "slider" %>

      <div class="difficulty-levels">
        <% Workout::DIFFICULTY_LEVELS.each_value do |label| %>
          <span><%= label %></span>
        <% end %>
      </div>
    </div>

  <% end %>

  <%= f.button :submit, "Generate workout",
        class: "workout-form__submit" %>

<% end %>
