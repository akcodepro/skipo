<% greeting_message = [
  {
    title: "Ready to jump, #{@display_name}?",
    subtitle: "Your rope's not going to swing itself."
  },
  {
    title: "Keen for a jump, #{@display_name}?",
    subtitle: "Let's cook up a workout that's all you."
  },
  {
    title: "Good to have you here, #{@display_name}.",
    subtitle: "What are we jumping into today?"
  },
  {
    title: "Let's skip to it, #{@display_name}.",
    subtitle: "Your next session starts here."
  },
  {
    title: "What's the jump, #{@display_name}?",
    subtitle: "Let's find a workout that fits your vibe."
  }
].sample %>

<div class="workout-builder">
  <header class="workout-builder__header">
    <h1 class="workout-builder__title"><%= greeting_message[:title] %></h1>
    <p class="workout-builder__subtitle"><%= greeting_message[:subtitle] %></p>
  </header>

  <% if @resumable_session %>
    <div class="resume-workout-banner">
      <p>You've got a workout in progress.</p>

      <%= link_to "Resume workout",
            workout_session_path(@resumable_session),
            class: "resume-workout-banner__link" %>
    </div>
  <% end %>

  <%= render "form", workout: @workout %>
</div>
