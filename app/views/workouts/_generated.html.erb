<div id="workout_generation" class="generated-workout">

  <header class="generated-workout__header">
    <h1 class="generated-workout__title">
      <%= workout.title %>
    </h1>

    <p class="generated-workout__description">
      <%= workout.description %>
    </p>
  </header>

  <section class="generated-workout__summary">
    <div class="generated-workout__stat">
      <span class="generated-workout__stat-label">Requested duration</span>
      <span class="pill pill--duration">
        <i class="fa fa-clock-o pill__icon" aria-hidden="true"></i>
        <%= format_duration(workout.requested_duration_seconds) %>
      </span>
    </div>

    <div class="generated-workout__stat">
      <span class="generated-workout__stat-label">Actual duration</span>
      <span class="pill pill--duration">
        <i class="fa fa-hourglass-half pill__icon" aria-hidden="true"></i>
        <%= format_duration(workout.total_duration_seconds) %>
      </span>
    </div>

    <div class="generated-workout__stat">
      <span class="generated-workout__stat-label">Difficulty</span>
      <span class="pill pill--difficulty">
        <%= Workout::DIFFICULTY_LEVELS[workout.difficulty] %>
      </span>
    </div>

    <div class="generated-workout__stat">
      <span class="generated-workout__stat-label">Focus</span>

      <div class="generated-workout__focuses">
        <% workout.focus.each do |focus| %>
          <span class="pill pill--focus">
            <%= focus.titleize %>
          </span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="generated-workout__exercises">
    <h2 class="generated-workout__section-title">Your exercises</h2>

    <ol class="generated-workout__list">
      <% workout.workout_exercises.each do |workout_exercise| %>
        <li class="generated-workout__exercise">
          <div class="generated-workout__exercise-header">
            <h3 class="generated-workout__exercise-title">
              <%= workout_exercise.exercise.name %>
            </h3>
          </div>

          <div class="generated-workout__exercise-details">
            <span class="pill pill--duration">
              <i class="fa fa-bolt pill__icon" aria-hidden="true"></i>
              Work: <%= format_duration(workout_exercise.duration_seconds) %>
            </span>

            <span class="pill pill--rest">
              <i class="fa fa-pause pill__icon" aria-hidden="true"></i>
              Rest: <%= format_duration(workout_exercise.rest_seconds) %>
            </span>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <div class="generated-workout__actions">
    <%= button_to "Start workout",
          workout_workout_sessions_path(workout),
          class: "generated-workout__start-button" %>
  </div>

</div>
