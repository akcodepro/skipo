<div id="workout_generation" class="generated-workout" data-controller="sheet">
  <section class="generated-workout__hero">
    <svg
      class="generated-workout__blob"
      viewBox="0 0 1000 1000"
      aria-hidden="true"
      fill="currentColor"
    >
      <path d="M877.5 645q-31.5 145-167 212.5T466 836q-109-89-134.5-177t-131-197.5Q95 352 180 222t221-30q136 100 243.5 98t186 104q78.5 106 47 251Z" />
    </svg>

    <%= render "shared/header", inverse: true, signed_in: true %>

    <div class="generated-workout__chips">
      <span class="pill pill--fundamentals">
        <%= focus_icon("fundamentals", extra_class: "pill__icon") %>
        Fundamentals
      </span>

      <% (workout.focus - ["fundamentals"]).each do |focus| %>
        <span class="pill pill--outline">
          <%= focus_icon(focus, extra_class: "pill__icon") %>
          <%= focus.titleize %>
        </span>
      <% end %>
    </div>

    <h1 class="generated-workout__title">
      <%= workout.title %>
    </h1>

    <div class="generated-workout__stats">
      <div class="generated-workout__stat">
        <div class="generated-workout__stat-value">
          <span class="generated-workout__stat-number"><%= workout.total_duration_seconds / 60 %></span>
          <span class="generated-workout__stat-unit">min</span>
        </div>
        <span class="generated-workout__stat-label">Total</span>
      </div>

      <div class="generated-workout__stat">
        <div class="generated-workout__stat-value">
          <span class="generated-workout__stat-number"><%= workout.workout_exercises.size %></span>
        </div>
        <span class="generated-workout__stat-label">Moves</span>
      </div>

      <div class="generated-workout__stat">
        <div class="generated-workout__stat-value generated-workout__stat-value--level">
          <%= Workout::DIFFICULTY_LEVELS[workout.difficulty] %>
        </div>
        <span class="generated-workout__stat-label">Level</span>
      </div>
    </div>

    <p class="generated-workout__description">
      <%= workout.description %>
    </p>
  </section>

  <section class="generated-workout__exercises">
    <h2 class="visually-hidden">Your exercises</h2>

    <div class="rhythm-strip" aria-hidden="true">
      <div class="rhythm-strip__bar">
        <% rhythm_segments(workout).each do |segment| %>
          <div
            class="rhythm-strip__segment rhythm-strip__segment--<%= segment[:kind] %>"
            style="--seconds: <%= segment[:seconds] %>;"
          ></div>
        <% end %>
      </div>

      <div class="rhythm-strip__legend">
        <span class="rhythm-strip__key">
          <span class="rhythm-strip__swatch rhythm-strip__swatch--work"></span>
          Jump
        </span>

        <span class="rhythm-strip__key">
          <span class="rhythm-strip__swatch rhythm-strip__swatch--rest"></span>
          Rest
        </span>
      </div>
    </div>

    <ol class="timeline">
      <% workout.workout_exercises.each_with_index do |workout_exercise, index| %>
        <li class="timeline__item">
          <%= link_to workout_workout_exercise_path(workout, workout_exercise),
            class: "timeline__move",
            data: {
              turbo_frame: "exercise_detail",
              action: "sheet#open"
            } do
          %>
            <span class="timeline__dot" aria-hidden="true"></span>

            <span class="timeline__name">
              <%= workout_exercise.exercise.name %>
            </span>

            <span class="timeline__time">
              <%= workout_exercise.duration_seconds %>s
            </span>

            <i class="fa-solid fa-chevron-right timeline__chevron" aria-hidden="true"></i>
          <% end %>

          <% if index < workout.workout_exercises.size - 1 &&
                workout_exercise.rest_seconds.to_i.positive? %>
            <div class="timeline__rest">
              <span><%= workout_exercise.rest_seconds %>s rest</span>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>

  <dialog class="sheet" data-sheet-target="dialog" data-action="click->sheet#closeOnBackdrop">
    <span class="sheet__grabber" aria-hidden="true"></span>

    <button
      type="button"
      class="sheet__close"
      aria-label="Close"
      data-action="sheet#close"
    >
      <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>

    <%= turbo_frame_tag "exercise_detail", data: { sheet_target: "frame" } %>
  </dialog>

  <div class="action-bar">
    <%= button_to "Start workout",
      workout_workout_sessions_path(workout),
      class: "button button--primary button--block action-bar__primary",
      form: { class: "action-bar__form" }
    %>
  </div>
</div>
