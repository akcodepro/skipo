<% liked = shared_workout.liked_by?(current_user) %>

<div id="<%= dom_id(shared_workout, :like) %>">
  <%= button_to shared_workout_like_path(shared_workout),
        method: liked ? :delete : :post,
        class: "like-button #{ 'like-button--liked' if liked }",
        aria: { pressed: liked } do %>
    <svg class="like-button__icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M7 10v12"></path>
      <path d="M15 5.9 14 10h5.8a2 2 0 0 1 1.9 2.6l-2.3 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.8a2 2 0 0 0 1.8-1.1L12 2a3.1 3.1 0 0 1 3 3.9Z"></path>
    </svg>
    <span class="like-button__count"><%= shared_workout.likes.size %></span>
  <% end %>
</div>
