<article class="feed-post">
  <div class="feed-post__header">
    <%= render "shared/avatar", user: shared_workout.user %>
    <div class="feed-post__author">
      <span class="feed-post__name">
        <%= shared_workout.user.display_name %>
      </span>
      <span class="feed-post__time">
        <%= time_ago_in_words(shared_workout.created_at) %> ago
      </span>
    </div>
  </div>

  <div class="feed-post__heading">
    <h2 class="feed-post__title">
      <%= shared_workout.workout_session.workout.title %>
    </h2>
    <span class="feed-post__duration">
      <%= human_duration(shared_workout.workout_session.actual_duration_seconds) %>
    </span>
  </div>

  <% if shared_workout.caption.present? %>
    <p class="feed-post__caption">
      <%= shared_workout.caption %>
    </p>
  <% end %>

  <div class="feed-post__media">
    <% if shared_workout.photo.attached? %>
      <%= image_tag shared_workout.photo,
        class: "feed-post__photo",
        alt: "#{shared_workout.user.display_name}'s workout photo",
        loading: "lazy" %>
    <% else %>
      <%= render "shared/move_grid",
        workout: shared_workout.workout_session.workout %>
    <% end %>
  </div>

  <div class="feed-post__footer">
    <div class="feed-post__pills">
      <%= render "shared/focus_pills",
        workout: shared_workout.workout_session.workout %>
    </div>

    <span class="feed-post__likes">
      <%= pluralize(shared_workout.likes.size, "like") %>
    </span>
  </div>
</article>
